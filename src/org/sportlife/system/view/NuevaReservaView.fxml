<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" styleClass="content"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.sportlife.system.controller.NuevaReservaController">

    <padding>
        <Insets bottom="20.0" left="10.0" right="20.0" top="20.0" />
    </padding>

    <!-- ENCABEZADO -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label styleClass="header-title" text="Nueva Reserva" />
        <Region HBox.hgrow="ALWAYS" />
        <HBox alignment="CENTER" spacing="8.0" styleClass="user-badge">
            <padding>
                <Insets bottom="6.0" left="16.0" right="16.0" top="6.0" />
            </padding>
            <Label styleClass="user-icon" text="●" />
            <Label styleClass="user-text" text="CLIENTE" />
        </HBox>
    </HBox>

    <!-- PANEL PRINCIPAL -->
    <VBox spacing="20.0" styleClass="main-card" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
        </padding>

        <Label styleClass="welcome-title" text="¡Reserva tu cancha!" />
        <Label styleClass="welcome-subtitle" text="Llena el formulario para solicitar tu reserva." />

        <HBox spacing="30.0" VBox.vgrow="ALWAYS">

            <!-- COLUMNA IZQUIERDA -->
            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                <Label text="DEPORTE" styleClass="form-label"/>
                <ComboBox fx:id="cmbSport" prefHeight="35.0" maxWidth="Infinity"
                          promptText="Selecciona deporte" styleClass="green-combo"/>

                <Label text="CANCHA DISPONIBLE" styleClass="form-label"/>
                <ComboBox fx:id="cmbCourt" prefHeight="35.0" maxWidth="Infinity"
                          promptText="Selecciona la cancha" styleClass="green-combo"/>

                <Label text="FECHA DE RESERVA" styleClass="form-label"/>
                <DatePicker fx:id="dpReservationDate" prefHeight="35.0" maxWidth="Infinity"/>
            </VBox>

            <!-- COLUMNA DERECHA -->
            <VBox spacing="10.0" prefWidth="320.0" minWidth="320.0">
                <Label text="HORARIO DE INICIO" styleClass="form-label"/>
                <Spinner fx:id="spnStartTime" prefHeight="35.0"/>

                <Label text="HORARIO DE FINALIZACIÓN" styleClass="form-label"/>
                <Spinner fx:id="spnEndTime" prefHeight="35.0"/>

                <Label text="HORAS TOTALES" styleClass="form-label"/>
                <Label fx:id="lblTotalHours" text="0 horas" prefHeight="35.0" maxWidth="Infinity"
                       style="-fx-background-color: #F3F4F6; -fx-background-radius: 6px; -fx-alignment: CENTER; -fx-font-weight: bold;"/>

                <Label text="TOTAL A PAGAR" styleClass="form-label"/>
                <Label fx:id="lblTotalCost" text="Q 0.00" prefHeight="40.0" maxWidth="Infinity"
                       style="-fx-background-color: #ECFDF5; -fx-background-radius: 6px; -fx-alignment: CENTER; -fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #065F46;"/>

                <Button fx:id="btnConfirmReservation" text="Confirmar Reserva"
                        onMouseClicked="#onRequestReservation"
                        prefHeight="42.0" maxWidth="Infinity"
                        style="-fx-background-color: #8CC63F; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-cursor: hand;"/>
            </VBox>

        </HBox>
    </VBox>
</VBox>