<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" styleClass="content"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.sportlife.system.controller.ReservasRecepcionistaController">

    <padding>
        <Insets bottom="20.0" left="10.0" right="20.0" top="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label styleClass="header-title" text="Todas las Reservas" />
        <Region HBox.hgrow="ALWAYS" />
    </HBox>

    <VBox spacing="20.0" styleClass="main-card" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
        </padding>

        <Label styleClass="welcome-title" text="Lista General de Reservas" />
        <Label styleClass="welcome-subtitle" text="Seleccione una reserva para actualizar su estado o editarla." />

        <!-- Filtro por estado -->
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <Label text="Filtrar por estado:" styleClass="form-label"/>
            <ComboBox fx:id="cmbStatusFilter" prefWidth="200.0" styleClass="green-combo"/>
        </HBox>

        <!-- Formulario de edición (colapsado abajo) -->
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <Label text="Fecha:" styleClass="form-label"/>
            <DatePicker fx:id="datePicker" prefWidth="150.0"/>
            <Label text="Hora inicio:" styleClass="form-label"/>
            <TextField fx:id="txtHoraInicio" prefWidth="100.0" promptText="HH:MM"/>
            <Label text="Hora fin:" styleClass="form-label"/>
            <TextField fx:id="txtHoraFin" prefWidth="100.0" promptText="HH:MM"/>
            <Label text="Estado:" styleClass="form-label"/>
            <ComboBox fx:id="cmbEstado" prefWidth="150.0" styleClass="green-combo"/>
        </HBox>

        <!-- Botones -->
        <HBox spacing="10.0">
            <Button fx:id="btnConfirm" text="✓ Confirmar" onMouseClicked="#onConfirm"
                    styleClass="action-button" prefWidth="130.0" />
            <Button fx:id="btnReject" text="✗ Rechazar" onMouseClicked="#onReject"
                    styleClass="action-button-danger" prefWidth="130.0" />
            <Button fx:id="btnCancel" text="⊘ Cancelar" onMouseClicked="#onCancel"
                    styleClass="action-button-danger" prefWidth="130.0" />
            <Button fx:id="btnUpdate" text="✎ Actualizar" onMouseClicked="#onUpdate"
                    styleClass="action-button" prefWidth="130.0" />
            <Button fx:id="btnDelete" text="🗑 Eliminar" onMouseClicked="#onDelete"
                    styleClass="action-button-danger" prefWidth="130.0" />
            <Button fx:id="btnRefresh" text="↻ Refrescar" onMouseClicked="#onRefresh"
                    styleClass="action-button" prefWidth="130.0" />
        </HBox>

        <!-- Tabla -->
        <TableView fx:id="tblReservations" styleClass="custom-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colIdReserva" prefWidth="60.0" text="N°" />
                <TableColumn fx:id="colClient" prefWidth="150.0" text="CLIENTE" />
                <TableColumn fx:id="colCourt" prefWidth="150.0" text="CANCHA" />
                <TableColumn fx:id="colDiscipline" prefWidth="90.0" text="DEPORTE" />
                <TableColumn fx:id="colDate" prefWidth="100.0" text="FECHA" />
                <TableColumn fx:id="colTimeRange" prefWidth="120.0" text="HORARIO" />
                <TableColumn fx:id="colTotalHours" prefWidth="70.0" text="HORAS" />
                <TableColumn fx:id="colCost" prefWidth="100.0" text="COSTO" />
                <TableColumn fx:id="colStatus" prefWidth="100.0" text="ESTADO" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
            </columnResizePolicy>
        </TableView>
    </VBox>
</VBox>