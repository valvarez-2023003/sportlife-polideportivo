<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" styleClass="content"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.sportlife.system.controller.GestionCanchasController">

    <padding>
        <Insets bottom="20.0" left="10.0" right="20.0" top="20.0" />
    </padding>

    <!-- ENCABEZADO SUPERIOR -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label fx:id="lblHeaderTitle" styleClass="header-title" text="Gestión de Canchas" />
        <Region HBox.hgrow="ALWAYS" />
        <HBox alignment="CENTER" spacing="8.0" styleClass="user-badge">
            <padding>
                <Insets bottom="6.0" left="16.0" right="16.0" top="6.0" />
            </padding>
            <Label fx:id="lblUserIcon" styleClass="user-icon" text="●" />
            <Label fx:id="lblUserRole" styleClass="user-text" text="Administrador" />
        </HBox>
    </HBox>

    <!-- PANEL PRINCIPAL (TARJETA BLANCA) -->
    <VBox spacing="20.0" styleClass="main-card" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
        </padding>

        <!-- TÍTULO -->
        <Label styleClass="welcome-title" text="Gestión de Canchas" />

        <!-- CONTENIDO: FORMULARIO (IZQ) + TABLA (DER) -->
        <HBox spacing="20.0" VBox.vgrow="ALWAYS">

            <!-- FORMULARIO -->
            <VBox spacing="10.0" prefWidth="300.0" minWidth="300.0" styleClass="form-panel">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <Label text="Datos de la cancha" styleClass="section-title"/>

                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <Label text="Código:" minWidth="90.0" styleClass="form-label"/>
                    <TextField fx:id="txtCode" HBox.hgrow="ALWAYS" styleClass="form-input"/>
                </HBox>

                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <Label text="Deporte:" minWidth="90.0" styleClass="form-label"/>
                    <ComboBox fx:id="cmbDiscipline" HBox.hgrow="ALWAYS" styleClass="green-combo" promptText="Seleccionar"/>
                </HBox>

                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <Label text="Techo:" minWidth="90.0" styleClass="form-label"/>
                    <ComboBox fx:id="cmbCovered" HBox.hgrow="ALWAYS" styleClass="green-combo" promptText="Seleccionar"/>
                </HBox>

                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <Label text="Estado:" minWidth="90.0" styleClass="form-label"/>
                    <ComboBox fx:id="cmbStatus" HBox.hgrow="ALWAYS" styleClass="green-combo" promptText="Seleccionar"/>
                </HBox>

                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <Label text="1 Hora:" minWidth="90.0" styleClass="form-label"/>
                    <TextField fx:id="txtPricePerHour" HBox.hgrow="ALWAYS" styleClass="form-input" promptText="Ej: 150.00"/>
                </HBox>

                <HBox spacing="8.0" alignment="TOP_LEFT">
                    <Label text="Descripción:" minWidth="90.0" styleClass="form-label"/>
                    <TextArea fx:id="txtDescription" prefRowCount="3" HBox.hgrow="ALWAYS" styleClass="form-textarea" promptText="Ej: Cancha de Fútbol 5 Norte"/>
                </HBox>

                <Region prefHeight="10.0"/>

                <!-- BOTONES DE ACCIÓN -->
                <HBox spacing="8.0">
                    <Button fx:id="btnAdd" text="Agregar" onMouseClicked="#onAdd" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="action-button"/>
                    <Button fx:id="btnUpdate" text="Editar" onMouseClicked="#onUpdate" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="action-button"/>
                </HBox>
                <HBox spacing="8.0">
                    <Button fx:id="btnDelete" text="Eliminar" onMouseClicked="#onDelete" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="action-button-danger"/>
                    <Button fx:id="btnClear" text="Limpiar" onMouseClicked="#onClear" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="action-button"/>
                </HBox>
            </VBox>

            <!-- TABLA -->
            <TableView fx:id="tblCourts" styleClass="custom-table" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCode" prefWidth="90.0" text="CÓDIGO" />
                    <TableColumn fx:id="colDescription" prefWidth="220.0" text="DESCRIPCIÓN" />
                    <TableColumn fx:id="colDiscipline" prefWidth="110.0" text="DEPORTE" />
                    <TableColumn fx:id="colCovered" prefWidth="110.0" text="TECHO" />
                    <TableColumn fx:id="colStatus" prefWidth="100.0" text="ESTADO" />
                    <TableColumn fx:id="colPricePerHour" prefWidth="110.0" text="1 HORA" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                </columnResizePolicy>
            </TableView>
        </HBox>
    </VBox>
</VBox>