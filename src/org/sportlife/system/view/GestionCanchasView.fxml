<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="1000.0" styleClass="root-pane" stylesheets="@../resource/styles/GestionCanchasStyle.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">

    <!-- MENÚ LATERAL -->
    <left>
        <VBox prefHeight="600.0" prefWidth="220.0" spacing="15.0" styleClass="sidebar">
            <padding>
                <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
            </padding>
            <children>
                <HBox alignment="CENTER">
                    <children>
                        <ImageView fx:id="imgLogo" fitHeight="70.0" fitWidth="180.0" preserveRatio="true">
                            <image>
                                <Image url="@../resource/images/logo.png" />
                            </image>
                        </ImageView>
                    </children>
                </HBox>

                <Region prefHeight="10.0" />

                <Button fx:id="btnAddCourt" maxWidth="1.7976931348623157E308" onMouseClicked="onAddCourt" prefHeight="40.0" styleClass="btn-sidebar" text="AGREGAR NUEVA CANCHA" />

                <Button fx:id="btnDeleteCourt" maxWidth="1.7976931348623157E308" onMouseClicked="onDeleteCourt" prefHeight="40.0" styleClass="btn-sidebar" text="ELIMINAR" />

                <Button fx:id="btnEditCourt" maxWidth="1.7976931348623157E308" onMouseClicked="onEditCourt" prefHeight="40.0" styleClass="btn-sidebar" text="EDITAR" />

                <Region VBox.vgrow="ALWAYS" />

                <Button fx:id="btnLogout" maxWidth="1.7976931348623157E308" onMouseClicked="onLogout" prefHeight="40.0" styleClass="btn-sidebar-logout" text="⇥   CERRAR SESIÓN" />
            </children>
        </VBox>
    </left>

    <!-- CONTENIDO PRINCIPAL -->
    <center>
        <VBox spacing="15.0" styleClass="content-area">
            <padding>
                <Insets bottom="20.0" left="10.0" right="20.0" top="20.0" />
            </padding>
            <children>

                <!-- ENCABEZADO SUPERIOR -->
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label fx:id="lblHeaderTitle" styleClass="header-title" text="Gestión de Gerencia" />
                        
                        <Region HBox.hgrow="ALWAYS" />

                        <HBox alignment="CENTER" spacing="8.0" styleClass="user-badge">
                            <padding>
                                <Insets bottom="6.0" left="16.0" right="16.0" top="6.0" />
                            </padding>
                            <children>
                                <Label fx:id="lblUserIcon" styleClass="user-icon" text="●" />
                                <Label fx:id="lblUserRole" styleClass="user-text" text="Administrador" />
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <!-- PANEL PRINCIPAL (TARJETA BLANCA) -->
                <VBox spacing="20.0" styleClass="main-card" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                    </padding>
                    <children>

                        <!-- TÍTULO PRINCIPAL -->
                        <Label fx:id="lblWelcomeTitle" styleClass="welcome-title" text="Gestión de Canchas" />

                        <!-- FILTROS -->
                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Label fx:id="lblCourtFilter" alignment="CENTER" prefHeight="32.0" prefWidth="150.0" styleClass="filter-pill-label" text="FILTRAR CANCHAS" />
                                        <ComboBox fx:id="cmbCourtFilter" prefHeight="32.0" prefWidth="130.0" promptText="FILTRAR" styleClass="green-combo" />
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Label fx:id="lblDisciplineFilter" alignment="CENTER" prefHeight="32.0" prefWidth="150.0" styleClass="filter-pill-label" text="DISCIPLINAS" />
                                        <ComboBox fx:id="cmbDisciplineFilter" prefHeight="32.0" prefWidth="130.0" promptText="FILTRAR" styleClass="green-combo" />
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <!-- TABLA DE CANCHAS -->
                        <TableView fx:id="tblCourts" styleClass="sports-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colCourtId" prefWidth="100.0" text="ID CANCHA" />
                                <TableColumn fx:id="colName" prefWidth="140.0" text="NOMBRE" />
                                <TableColumn fx:id="colDiscipline" prefWidth="140.0" text="DISCIPLINA" />
                                <TableColumn fx:id="colStatus" prefWidth="100.0" text="ESTADO" />
                                <TableColumn fx:id="colDescription" prefWidth="220.0" text="DESCRIPCIÓN" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>