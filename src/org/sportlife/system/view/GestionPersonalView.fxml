<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" styleClass="content"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.sportlife.system.controller.GestionPersonalController">

    <padding>
        <Insets bottom="20.0" left="10.0" right="20.0" top="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label styleClass="header-title" text="Gestión de Personal" />
        <Region HBox.hgrow="ALWAYS" />
        <HBox alignment="CENTER" spacing="8.0" styleClass="user-badge">
            <padding>
                <Insets bottom="6.0" left="16.0" right="16.0" top="6.0" />
            </padding>
            <Label styleClass="user-icon" text="●" />
            <Label styleClass="user-text" text="GERENTE" />
        </HBox>
    </HBox>

    <VBox spacing="20.0" styleClass="main-card" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
        </padding>

        <Label styleClass="welcome-title" text="Gestión de Personal" />
        <Label styleClass="welcome-subtitle" text="Cree, edite y elimine administradores y recepcionistas." />

        <HBox spacing="20.0" VBox.vgrow="ALWAYS">

            <!-- FORMULARIO -->
            <VBox spacing="10.0" prefWidth="320.0" minWidth="320.0" styleClass="form-panel">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <Label text="Datos del usuario" styleClass="section-title"/>

                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <Label text="Usuario:" minWidth="100.0" styleClass="form-label"/>
                    <TextField fx:id="txtUserName" HBox.hgrow="ALWAYS" styleClass="form-input"/>
                </HBox>

                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <Label text="Nombres:" minWidth="100.0" styleClass="form-label"/>
                    <TextField fx:id="txtName" HBox.hgrow="ALWAYS" styleClass="form-input"/>
                </HBox>

                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <Label text="Apellidos:" minWidth="100.0" styleClass="form-label"/>
                    <TextField fx:id="txtLastName" HBox.hgrow="ALWAYS" styleClass="form-input"/>
                </HBox>

                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <Label text="Correo:" minWidth="100.0" styleClass="form-label"/>
                    <TextField fx:id="txtEmail" HBox.hgrow="ALWAYS" styleClass="form-input"/>
                </HBox>

                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <Label text="Teléfono:" minWidth="100.0" styleClass="form-label"/>
                    <TextField fx:id="txtPhone" HBox.hgrow="ALWAYS" styleClass="form-input"/>
                </HBox>

                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <Label text="Contraseña:" minWidth="100.0" styleClass="form-label"/>
                    <PasswordField fx:id="pwdPassword" HBox.hgrow="ALWAYS" styleClass="form-input"/>
                </HBox>

                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <Label text="Confirmar:" minWidth="100.0" styleClass="form-label"/>
                    <PasswordField fx:id="pwdConfirmPassword" HBox.hgrow="ALWAYS" styleClass="form-input"/>
                </HBox>

                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <Label text="Rol:" minWidth="100.0" styleClass="form-label"/>
                    <ComboBox fx:id="cmbRole" HBox.hgrow="ALWAYS" styleClass="green-combo" promptText="Seleccionar"/>
                </HBox>

                <Region prefHeight="10.0"/>

                <HBox spacing="8.0">
                    <Button fx:id="btnAdd" text="Agregar" onMouseClicked="#onAdd" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="action-button"/>
                    <Button fx:id="btnUpdate" text="Editar" onMouseClicked="#onUpdate" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="action-button"/>
                </HBox>
                <HBox spacing="8.0">
                    <Button fx:id="btnDelete" text="Eliminar" onMouseClicked="#onDelete" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="action-button-danger"/>
                    <Button fx:id="btnClear" text="Limpiar" onMouseClicked="#onClear" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="action-button"/>
                </HBox>
            </VBox>

            <!-- TABLA -->
            <TableView fx:id="tblStaff" styleClass="custom-table" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colUserName" prefWidth="120.0" text="USUARIO" />
                    <TableColumn fx:id="colName" prefWidth="120.0" text="NOMBRES" />
                    <TableColumn fx:id="colLastName" prefWidth="120.0" text="APELLIDOS" />
                    <TableColumn fx:id="colEmail" prefWidth="180.0" text="CORREO" />
                    <TableColumn fx:id="colRole" prefWidth="110.0" text="ROL" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                </columnResizePolicy>
            </TableView>
        </HBox>
    </VBox>
</VBox>