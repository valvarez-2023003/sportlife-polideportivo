<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" styleClass="content"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.sportlife.system.controller.InicioGerenteController">

    <padding>
        <Insets bottom="20.0" left="10.0" right="20.0" top="20.0" />
    </padding>

    <!-- ENCABEZADO -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label styleClass="header-title" text="Panel de Gerente" />
        <Region HBox.hgrow="ALWAYS" />
        <HBox alignment="CENTER" spacing="8.0" styleClass="user-badge">
            <padding>
                <Insets bottom="6.0" left="16.0" right="16.0" top="6.0" />
            </padding>
            <Label styleClass="user-icon" text="●" />
            <Label styleClass="user-text" text="GERENTE" />
        </HBox>
    </HBox>

    <!-- PANEL PRINCIPAL -->
    <VBox spacing="20.0" styleClass="main-card" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
        </padding>

        <Label styleClass="welcome-title" text="Bienvenido, Gerente!" />
        <Label styleClass="welcome-subtitle" text="Vista general del catálogo de canchas del complejo deportivo." />

        <!-- FILTRO POR ESTADO -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label text="Filtrar por estado:" styleClass="form-label"/>
            <ComboBox fx:id="cmbStatusFilter" prefWidth="200.0" styleClass="green-combo"/>
        </HBox>

        <!-- TABLA DE CANCHAS -->
        <TableView fx:id="tblCourts" styleClass="custom-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCode" prefWidth="100.0" text="CÓDIGO" />
                <TableColumn fx:id="colDescription" prefWidth="220.0" text="DESCRIPCIÓN" />
                <TableColumn fx:id="colDiscipline" prefWidth="120.0" text="DEPORTE" />
                <TableColumn fx:id="colCovered" prefWidth="110.0" text="TECHO" />
                <TableColumn fx:id="colStatus" prefWidth="120.0" text="ESTADO" />
                <TableColumn fx:id="colPricePerHour" prefWidth="120.0" text="PRECIO/HORA" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
            </columnResizePolicy>
        </TableView>
    </VBox>
</VBox>