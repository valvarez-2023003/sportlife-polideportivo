<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" styleClass="content"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.sportlife.system.controller.AdminController">

    <padding>
        <Insets bottom="15" left="15" right="15" top="10" />
    </padding>

    <!-- ENCABEZADO SUPERIOR -->
    <HBox fx:id="pnlHeader" alignment="CENTER_LEFT" spacing="10" styleClass="top-header">
        <Label fx:id="lblHeaderTitle" styleClass="header-title" text="Panel de Administración" />

        <Region HBox.hgrow="ALWAYS" />

        <HBox fx:id="pnlUserBadge" alignment="CENTER" spacing="8" styleClass="user-badge">
            <Label fx:id="lblUserIcon" styleClass="user-icon" text="👤" />
            <Label fx:id="lblUserRole" styleClass="user-text" text="ADMINISTRADOR" />
        </HBox>
    </HBox>

    <!-- PANEL BLANCO CONTENEDOR PRINCIPAL -->
    <VBox fx:id="pnlMainCard" spacing="12" styleClass="main-card" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="15" left="20" right="20" top="15" />
        </padding>

        <!-- TÍTULO PRINCIPAL Y SUBTÍTULO -->
        <VBox fx:id="pnlWelcomeContainer" spacing="2">
            <Label fx:id="lblWelcomeTitle" styleClass="welcome-title" text="Bienvenido, Administrador!" />
            <Label fx:id="lblWelcomeSubtitle" styleClass="welcome-subtitle" text="Desde aquí puedes gestionar las canchas del polideportivo" />
        </VBox>

        <!-- TARJETA DE ESTADÍSTICA -->
        <HBox fx:id="pnlStatCard" alignment="CENTER_LEFT" prefHeight="70.0" prefWidth="250.0" spacing="12" styleClass="stat-card">
            <Label fx:id="lblStatCardTitle" styleClass="stat-card-title" text="CANCHAS DISPONIBLES" wrapText="true" />
        </HBox>

        <!-- TABLA DE CANCHAS -->
        <TableView fx:id="tblFields" styleClass="custom-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCode" prefWidth="100.0" text="CÓDIGO" />
                <TableColumn fx:id="colDescription" prefWidth="220.0" text="DESCRIPCIÓN" />
                <TableColumn fx:id="colDiscipline" prefWidth="120.0" text="DEPORTE" />
                <TableColumn fx:id="colCovered" prefWidth="110.0" text="TECHO" />
                <TableColumn fx:id="colStatus" prefWidth="120.0" text="ESTADO" />
                <TableColumn fx:id="colPricePerHour" prefWidth="120.0" text="1 HORA" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
            </columnResizePolicy>
        </TableView>
    </VBox>
</VBox>