<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="pnlRoot" prefHeight="600.0" prefWidth="1000.0" styleClass="root-pane" stylesheets="@../resource/styles/ResumenInventarioStyle.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">

    <!-- MENU LATERAL -->
    <left>
        <VBox fx:id="pnlSidebar" prefHeight="600.0" prefWidth="200.0" spacing="15.0" styleClass="sidebar">
            <padding>
                <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <ImageView fx:id="imgLogo" fitHeight="60.0" fitWidth="170.0" preserveRatio="true">
                            <image>
                                <Image url="@../resource/images/logo.png" />
                            </image>
                        </ImageView>
                    </children>
                </HBox>

                <Button fx:id="btnAddArticle" onMouseClicked="#onAddArticle" maxWidth="1.7976931348623157E308" prefHeight="38.0" styleClass="btn-sidebar" text="AGREGAR NUEVO ARTICULO" />

                <Button fx:id="btnEditStatus" onMouseClicked="#onEditStatus" maxWidth="1.7976931348623157E308" prefHeight="38.0" styleClass="btn-sidebar" text="EDITAR ESTADO ARTICULO" />

                <Region VBox.vgrow="ALWAYS" />

                <Button fx:id="btnLogout" onMouseClicked="#onLogout" maxWidth="1.7976931348623157E308" prefHeight="38.0" styleClass="btn-sidebar-logout" text="⇥    CERRAR SESIÓN" />
            </children>
        </VBox>
    </left>

    <!-- CONTENIDO PRINCIPAL -->
    <center>
        <VBox fx:id="pnlContent" spacing="15.0" styleClass="content-area">
            <padding>
                <Insets bottom="20.0" left="10.0" right="20.0" top="20.0" />
            </padding>
            <children>

                <!-- ENCABEZADO SUPERIOR -->
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label fx:id="lblHeaderTitle" styleClass="header-title" text="Gestión de Inventario" />
                        
                        <Region HBox.hgrow="ALWAYS" />

                        <HBox fx:id="pnlUserBadge" alignment="CENTER" spacing="10.0" styleClass="user-badge">
                            <padding>
                                <Insets bottom="4.0" left="15.0" right="15.0" top="4.0" />
                            </padding>
                            <children>
                                <Label fx:id="lblUserIcon" styleClass="user-icon" text="👤" />
                                <Label fx:id="lblUserRole" styleClass="user-text" text="GERENTE" />
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <!-- PANEL BLANCO PRINCIPAL -->
                <VBox fx:id="pnlMainCard" spacing="15.0" styleClass="main-card" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
                    </padding>
                    <children>

                        <!-- TITULOS -->
                        <VBox fx:id="pnlTitles" spacing="4.0">
                            <children>
                                <Label fx:id="lblWelcomeTitle" styleClass="welcome-title" text="Resumen De Inventario" />
                                <Label fx:id="lblWelcomeSubtitle" styleClass="welcome-subtitle" text="SUPERVISA EL ESTADO DE LOS TIKETS Y LA CARGA DEL EQUIPO" />
                            </children>
                        </VBox>

                        <!-- FILTROS CONTENEDORES -->
                        <HBox fx:id="pnlFilters" alignment="CENTER_LEFT" spacing="20.0">
                            <children>
                                <HBox fx:id="pnlFilterGroupOne" alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label fx:id="lblInventoryFilter" alignment="CENTER" prefHeight="30.0" prefWidth="160.0" styleClass="filter-pill-label" text="FILTRAR INVENTARIO" />
                                        <ComboBox fx:id="cmbInventoryFilter" prefHeight="30.0" prefWidth="120.0" styleClass="green-combo" />
                                    </children>
                                </HBox>

                                <HBox fx:id="pnlFilterGroupTwo" alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label fx:id="lblCategoryFilter" alignment="CENTER" prefHeight="30.0" prefWidth="160.0" styleClass="filter-pill-label" text="CATEGORIA" />
                                        <ComboBox fx:id="cmbCategoryFilter" prefHeight="30.0" prefWidth="120.0" styleClass="green-combo" />
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <!-- TABLA DE INVENTARIO -->
                        <TableView fx:id="tblInventory" styleClass="support-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colSku" prefWidth="70.0" text="SKU" />
                                <TableColumn fx:id="colArticle" prefWidth="160.0" text="ARTÍCULO" />
                                <TableColumn fx:id="colCategory" prefWidth="120.0" text="CATEGORÍA" />
                                <TableColumn fx:id="colLocation" prefWidth="120.0" text="UBICACIÓN" />
                                <TableColumn fx:id="colAvailableQuantity" prefWidth="150.0" text="CANTIDAD DISPONIBLE" />
                                <TableColumn fx:id="colStatus" prefWidth="90.0" text="ESTADO" />
                                <TableColumn fx:id="colDate" prefWidth="90.0" text="FECHA" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>