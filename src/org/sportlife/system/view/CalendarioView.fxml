<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" styleClass="content" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.sportlife.system.controller.CalendarioController">

    <padding>
        <Insets bottom="20.0" left="10.0" right="20.0" top="20.0" />
    </padding>

    <!-- ENCABEZADO SUPERIOR -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label fx:id="lblHeaderTitle" styleClass="header-title" text="Calendario de Reservas" />
        <Region HBox.hgrow="ALWAYS" />
        <HBox alignment="CENTER" spacing="8.0" styleClass="user-badge">
            <padding>
                <Insets bottom="6.0" left="16.0" right="16.0" top="6.0" />
            </padding>
            <Label fx:id="lblUserIcon" styleClass="user-icon" text="●" />
            <Label fx:id="lblUserRole" styleClass="user-text" text="Administrador" />
        </HBox>
    </HBox>

    <!-- PANEL PRINCIPAL (TARJETA BLANCA) -->
    <VBox spacing="20.0" styleClass="main-card" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
        </padding>

        <!-- TÍTULO -->
        <Label styleClass="welcome-title" text="Calendario de Reservas" />

        <!-- TABLA DE RESERVAS -->
        <TableView fx:id="tblReservations" styleClass="custom-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colDate" prefWidth="130.0" text="FECHA" />
                <TableColumn fx:id="colCourt" prefWidth="200.0" text="CANCHA" />
                <TableColumn fx:id="colDiscipline" prefWidth="130.0" text="DISCIPLINA" />
                <TableColumn fx:id="colTotalHours" prefWidth="130.0" text="HORAS TOTALES" />
                <TableColumn fx:id="colCovered" prefWidth="140.0" text="TECHO" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS" />
            </columnResizePolicy>
        </TableView>
    </VBox>
</VBox>
