<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="pnlRoot" prefHeight="600.0" prefWidth="1000.0" styleClass="admin-root" stylesheets="@../resource/styles/CalendarioReservasStyle.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">

    <!-- ===================================================== -->
    <!-- BARRA LATERAL IZQUIERDA -->
    <!-- ===================================================== -->
    <left>
        <VBox fx:id="pnlSidebar" prefWidth="180.0" spacing="15" styleClass="sidebar" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20" left="15" right="15" top="15" />
            </padding>
            <children>
                <!-- LOGO -->
                <ImageView fx:id="imgLogo" fitHeight="60.0" fitWidth="150.0" preserveRatio="true">
                    <image>
                        <Image url="@../resource/images/logo.png" />
                    </image>
                </ImageView>

                <Region VBox.vgrow="ALWAYS" />

                <!-- BOTONES INFERIORES -->
                <Button fx:id="btnEdit" onMouseClicked="onEdit" maxWidth="Infinity" styleClass="btn-outline-green" text="EDITAR" />
                <Button fx:id="btnLogout" onMouseClicked="onLogout" maxWidth="Infinity" styleClass="btn-outline-green" text="⇥  CERRAR SESIÓN" />
            </children>
        </VBox>
    </left>

    <!-- ===================================================== -->
    <!-- PANEL CENTRAL -->
    <!-- ===================================================== -->
    <center>
        <VBox fx:id="pnlContent" spacing="10" styleClass="content-area" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15" left="10" right="20" top="15" />
            </padding>
            <children>

                <!-- ENCABEZADO SUPERIOR -->
                <HBox fx:id="pnlHeader" alignment="CENTER_LEFT" spacing="10">
                    <children>
                        <Label fx:id="lblHeaderTitle" styleClass="header-main-title" text="Calendario" />
                        <Region HBox.hgrow="ALWAYS" />
                        
                        <!-- CHIP DE USUARIO -->
                        <HBox fx:id="pnlUserBadge" alignment="CENTER" spacing="10" styleClass="user-badge">
                            <children>
                                <Label fx:id="lblUserIcon" styleClass="user-avatar" text="👤" />
                                <Label fx:id="lblUserName" styleClass="user-name" text="USER" />
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <!-- CONTENEDOR BLANCO PRINCIPAL -->
                <VBox fx:id="pnlMainCard" spacing="15" styleClass="main-card" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="20" left="25" right="25" top="20" />
                    </padding>
                    <children>

                        <!-- TÍTULOS -->
                        <VBox fx:id="pnlTitleContainer" spacing="2">
                            <children>
                                <Label fx:id="lblCardTitle" styleClass="card-title" text="Calendario de reservas" />
                                <Label fx:id="lblCardSubtitle" styleClass="card-subtitle" text="VISUALIZA Y GESTIONA LA AGENDA DE LAS CANCHAS POR SEMANA" />
                            </children>
                        </VBox>

                        <!-- FILTROS Y SELECCIONES -->
                        <HBox fx:id="pnlFiltersContainer" spacing="20">
                            <children>
                                <!-- COLUMNA 1: DISCIPLINAS -->
                                <VBox fx:id="pnlDisciplinesContainer" prefWidth="200.0" spacing="5">
                                    <children>
                                        <Label fx:id="lblDisciplinesHeader" maxWidth="Infinity" styleClass="filter-header" text="DISCIPLINAS" />
                                        <ListView fx:id="lstDisciplines" prefHeight="110.0" styleClass="green-list-view" />
                                    </children>
                                </VBox>

                                <!-- COLUMNA 2: CANCHA -->
                                <VBox fx:id="pnlCourtsContainer" prefWidth="200.0" spacing="5">
                                    <children>
                                        <Label fx:id="lblCourtsHeader" maxWidth="Infinity" styleClass="filter-header" text="CANCHA" />
                                        <ListView fx:id="lstCourts" prefHeight="110.0" styleClass="green-list-view" />
                                    </children>
                                </VBox>

                                <!-- COLUMNA 3: SEMANA DEL -->
                                <VBox fx:id="pnlWeekContainer" prefWidth="200.0" spacing="10">
                                    <children>
                                        <Label fx:id="lblWeekHeader" maxWidth="Infinity" styleClass="filter-header" text="SEMANA DEL" />
                                        <ComboBox fx:id="cmbWeek" maxWidth="Infinity" promptText="FECHA:---------" styleClass="green-combo" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <!-- TABLA DE HORARIOS Y DÍAS -->
                        <TableView fx:id="tblSchedule" prefHeight="333.0" prefWidth="740.0" styleClass="green-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colTime" prefWidth="60.0" text="HORA" />
                                <TableColumn fx:id="colMonday" prefWidth="90.0" text="LUNES" />
                                <TableColumn fx:id="colTuesday" prefWidth="90.0" text="MARTES" />
                                <TableColumn fx:id="colWednesday" prefWidth="90.0" text="MIÉRCOLES" />
                                <TableColumn fx:id="colThursday" prefWidth="90.0" text="JUEVES" />
                                <TableColumn fx:id="colFriday" prefWidth="90.0" text="VIERNES" />
                                <TableColumn fx:id="colSaturday" prefWidth="90.0" text="SÁBADO" />
                                <TableColumn fx:id="colSunday" prefWidth="90.0" text="DOMINGO" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <!-- BOTÓN ACCIÓN INFERIOR -->
                        <HBox fx:id="pnlBottomActionContainer" alignment="CENTER_RIGHT" />

                    </children>
                </VBox>

            </children>
        </VBox>
    </center>

</BorderPane>