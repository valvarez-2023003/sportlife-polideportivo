<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="pnlRoot" prefHeight="600.0" prefWidth="1000.0" styleClass="admin-root"
            stylesheets="@../resource/styles/AdminStyle.css, @../resource/styles/GestionCanchasStyle.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.sportlife.system.controller.BarraLateralRecepcionistaController">

    <left>
        <VBox fx:id="pnlSidebar" prefWidth="150.0" spacing="12" styleClass="sidebar">
            <padding>
                <Insets bottom="15" left="10" right="10" top="10" />
            </padding>

            <HBox fx:id="pnlLogoContainer" alignment="CENTER" styleClass="logo-container">
                <ImageView fx:id="imgLogo" fitHeight="50.0" fitWidth="120.0" preserveRatio="true">
                    <image>
                        <Image url="@../resource/images/logo.png" />
                    </image>
                </ImageView>
            </HBox>

            <Region prefHeight="10.0" />

            <Button fx:id="btnHome" maxWidth="Infinity" onMouseClicked="#onOpenHome"
                    styleClass="menu-button-selected" text="INICIO" />

            <Button fx:id="btnReservations" maxWidth="Infinity" onMouseClicked="#onOpenReservations"
                    styleClass="menu-button" text="RESERVAS" />

            <Button fx:id="btnClients" maxWidth="Infinity" onMouseClicked="#onOpenClients"
                    styleClass="menu-button" text="CLIENTES" />

            <Button fx:id="btnCalendar" maxWidth="Infinity" onMouseClicked="#onOpenCalendar"
                    styleClass="menu-button" text="CALENDARIO" />

            <Region VBox.vgrow="ALWAYS" />

            <Button fx:id="btnLogout" maxWidth="Infinity" onMouseClicked="#onLogout"
                    styleClass="logout-button" text="⇥   CERRAR SESIÓN" />
        </VBox>
    </left>

    <center>
        <StackPane fx:id="pnlContentCenter" styleClass="content" />
    </center>
</BorderPane>