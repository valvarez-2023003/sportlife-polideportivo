<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" styleClass="content"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.sportlife.system.controller.RecepcionistaController">

    <padding>
        <Insets bottom="20.0" left="10.0" right="20.0" top="20.0" />
    </padding>

    <!-- ENCABEZADO SUPERIOR -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label fx:id="lblHeaderTitle" styleClass="header-title" text="Panel de Recepcionista" />
        <Region HBox.hgrow="ALWAYS" />
        <HBox alignment="CENTER" spacing="8.0" styleClass="user-badge">
            <padding>
                <Insets bottom="6.0" left="16.0" right="16.0" top="6.0" />
            </padding>
            <Label fx:id="lblUserIcon" styleClass="user-icon" text="●" />
            <Label fx:id="lblUserRole" styleClass="user-text" text="Recepcionista" />
        </HBox>
    </HBox>

    <!-- PANEL PRINCIPAL -->
    <VBox spacing="20.0" styleClass="main-card" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
        </padding>

        <Label styleClass="welcome-title" text="Solicitudes de Reserva Pendientes" />
        <Label styleClass="welcome-subtitle" text="Confirme o rechace las solicitudes de los clientes." />

        <!-- BOTONES DE ACCIÓN -->
        <HBox spacing="10.0">
            <Button fx:id="btnConfirm" text="✓ Confirmar" onMouseClicked="#onConfirm"
                    styleClass="action-button" prefWidth="150.0" />
            <Button fx:id="btnReject" text="✗ Rechazar" onMouseClicked="#onReject"
                    styleClass="action-button-danger" prefWidth="150.0" />
            <Button fx:id="btnRefresh" text="↻ Actualizar" onMouseClicked="#onRefresh"
                    styleClass="action-button" prefWidth="150.0" />
        </HBox>

        <!-- TABLA DE SOLICITUDES PENDIENTES -->
        <TableView fx:id="tblPendingReservations" styleClass="custom-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colIdReserva" prefWidth="80.0" text="N°" />
                <TableColumn fx:id="colClient" prefWidth="160.0" text="CLIENTE" />
                <TableColumn fx:id="colCourt" prefWidth="130.0" text="CANCHA" />
                <TableColumn fx:id="colDiscipline" prefWidth="90.0" text="DEPORTE" />
                <TableColumn fx:id="colCovered" prefWidth="90.0" text="TECHO" />
                <TableColumn fx:id="colDate" prefWidth="100.0" text="FECHA" />
                <TableColumn fx:id="colTimeRange" prefWidth="130.0" text="HORARIO" />
                <TableColumn fx:id="colTotalHours" prefWidth="80.0" text="HORAS" />
                <TableColumn fx:id="colTotalCost" prefWidth="100.0" text="COSTO" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
            </columnResizePolicy>
        </TableView>
    </VBox>
</VBox>